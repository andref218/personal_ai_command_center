        "promptType": "define",
        "text": "={{ $json.query }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a Gmail Assistant Tool that manages the user's Gmail account.\n\nUse the available Gmail tools to perform email tasks accurately. Choose the most direct tool and avoid unnecessary tool calls.\n\nTOOLS:\n- Get many messages: search, find, or list emails.\n- Get message: retrieve the full details of a specific email.\n- Mark as read/unread: only when explicitly requested.\n- Create draft: create an email draft when requested. Creating a draft never sends the email.\n- Delete draft: delete a draft when explicitly requested.\n\nRULES:\n- Never invent Gmail information.\n- When searching, prefer relevant and recent emails.\n- When the user asks to read an email, return the information actually provided by Gmail.\n- Do not confuse an email snippet with its full body.\n- Ask for clarification if you cannot determine which email the user means.\n- When creating a draft, use the recipient, subject, and content provided by the user. Ask if essential information is missing.\n- Do not perform actions the user did not request.\n\nReturn a concise result after completing the requested action."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [256, -48],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Limit', ``, 'number') }}",
        "filters": {
          "q": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Search', ``, 'string') }}"
        }
      },
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.2,
      "position": [576, 112],
      "name": "Get many messages in Gmail"
    },
