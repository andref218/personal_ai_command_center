      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [304, 496],
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "description": "You have access to a Gmail Assistant Tool for interacting with the user's Gmail account.\n\nUse this tool whenever the user asks to find, search, read, retrieve, inspect, or summarize emails from Gmail.\n\nPass the user's request to the Gmail Assistant Tool clearly and accurately.\n\nThe Gmail Assistant Tool is responsible for deciding how to search for emails and when to retrieve the full content of a specific email.\n\nDo not try to access Gmail directly or invent email information, message IDs, or search results.\n\nUse the information returned by the Gmail Assistant Tool to answer the user's request.\n\nExamples:\n- \"Find emails from Natixis\"\n- \"Show me unread emails from LinkedIn\"\n- \"Find emails about job applications\"\n- \"Read the latest email from Natixis and summarize it\"\n- \"What did they say in the email about the interview?\"",
        "workflowId": {
          "__rl": true,
          "value": "YOUR_GMAIL_WORKFLOW_ID",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "query": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('query', ``, 'string') }}"
          },
          "matchingColumns": ["query"],
          "schema": [
            {
              "id": "query",
              "displayName": "query",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [544, 528],
      "name": "Call 'Gmail - Assistant Tool'"
    },
    {
      "parameters": {
        "description": "You have access to a Google Calendar Assistant Tool for interacting with the user's Google Calendar.\n\nUse this tool whenever the user asks to find, search, read, retrieve, create, update, or delete calendar events.\n\nPass the user's request to the Google Calendar Assistant Tool clearly and accurately.\n\nThe Google Calendar Assistant Tool is responsible for deciding which calendar actions and tools are required.\n\nDo not try to access Google Calendar directly or invent calendar information, event IDs, or search results.\n\nUse the information returned by the Google Calendar Assistant Tool to answer the user's request.",
        "workflowId": {
