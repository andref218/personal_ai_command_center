      "parameters": {
        "jsCode": "const original = $('When Executed by Another Workflow').first().json;\n\nconst headers = original.headers;\nconst rows = original.rows;\n\nif (!Array.isArray(headers) || !Array.isArray(rows)) {\n  throw new Error('Invalid Headers or Rows.');\n}\n\nreturn rows.map((row) => ({\n  json: Object.fromEntries(\n    headers.map((header, index) => [\n      header,\n      row[index] ?? ''\n    ])\n  )\n}));"
      },
